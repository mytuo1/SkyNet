# ═══════════════════════════════════════════════════════════════════════════════
# BRAIN SYSTEM — ROOT ENVIRONMENT
# Copy this to .env and fill in your values.
# Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider (choose one or both) ─────────────────────────────────────────
LLM_PROVIDER=anthropic          # anthropic | openai | both
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here    # optional — needed if LLM_PROVIDER=openai

# ── Model selection ────────────────────────────────────────────────────────────
# Anthropic models
ANTHROPIC_MAIN_MODEL=claude-sonnet-4-20250514
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# OpenAI models (used if LLM_PROVIDER=openai)
OPENAI_MAIN_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# Resolved at runtime by shared/llm_provider.py
DEFAULT_CLAUDE_MODEL=claude-sonnet-4-20250514
FAST_CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Database credentials ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=                 # leave empty for dev, set for production

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=         # leave empty for dev, set for production

EDGEDB_DSN=edgedb://edgedb/main
EDGEDB_HOST=edgedb
EDGEDB_PORT=5656
EDGEDB_DATABASE=main

# ── Local model (Learner service) ──────────────────────────────────────────────
# The local model handles routine tasks, learns incrementally.
# Does NOT need to be powerful — Phi-4-mini or Qwen2.5-1.5B is enough.
LOCAL_MODEL_NAME=microsoft/phi-4-mini-instruct   # pulled from HuggingFace
LOCAL_MODEL_PATH=/models/local_llm               # mounted volume
ADAPTER_PATH=/models/adapters                    # LoRA adapters
EMOTION_MODEL_PATH=/models/emotion               # emotion classifier
HF_TOKEN=hf_your-huggingface-token-here         # for gated models
HF_HOME=/models/hf_cache

# ── Ollama (embedding + local inference) ──────────────────────────────────────
OLLAMA_URL=http://host.docker.internal:11434     # Mac/Linux host
# OLLAMA_URL=http://ollama:11434                 # if running Ollama in Docker
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LOCAL_MODEL=phi4

# ── Self-update / OpenClaw integration ────────────────────────────────────────
OPENCLAW_WEBHOOK_SECRET=change-this-to-a-random-secret-min-32-chars
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_REPO=your-username/brain-system           # repo for code self-updates
AUTO_APPLY_CODE_CHANGES=false                    # true = auto-deploy new services
CODE_REVIEW_REQUIRED=true                        # require human approval for code

# ── Vision service ─────────────────────────────────────────────────────────────
VISION_ENABLED=false                             # set to true to enable camera
VISION_MODEL=openai/clip-vit-base-patch32        # CLIP for visual embeddings
VISION_CAPTURE_INTERVAL=5                        # seconds between captures (0=manual only)
CAMERA_INDEX=0                                   # camera device index
VISION_RESOLUTION=640x480
VISION_STORE_FRAMES=false                        # persist frames to disk

# ── Service URLs (internal Docker network) ────────────────────────────────────
AMYGDALA_URL=http://amygdala:8001
HIPPOCAMPUS_URL=http://hippocampus:8002
CEREBELLUM_URL=http://cerebellum:8003
NEOCORTEX_URL=http://neocortex:8004
WORKING_MEMORY_URL=http://working-memory:8005
PERCEPTION_URL=http://perception:8006
VERIFICATION_URL=http://verification:8007
CROSS_DOMAIN_URL=http://cross-domain:8008
COMPASS_URL=http://compass:8009
FRAMEWORK_ROUTER_URL=http://framework-router:8010
SELF_UPDATE_URL=http://self-update:8011
KNOBS_URL=http://knobs:8090
CAUSAL_GRAPH_URL=http://causal-graph:8012
SIMULATOR_URL=http://simulator:8013
METACOGNITION_URL=http://metacognition:8014
GOALS_URL=http://goals:8015
LEARNER_URL=http://learner:8016
VISION_URL=http://vision:8017
THALAMUS_URL=http://thalamus:8000

# ── Resource limits ────────────────────────────────────────────────────────────
# Adjust based on your hardware (see DEPLOYMENT.md)
ES_JAVA_OPTS=-Xms2g -Xmx2g
REDIS_MAX_MEMORY=1gb
LEARNER_MAX_MEMORY=8g          # local model needs RAM
VISION_MAX_MEMORY=4g

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
STRUCTURED_LOGGING=true

# ── Paths ──────────────────────────────────────────────────────────────────────
WORKSPACE_PATH=/workspace
MODELS_PATH=/models
