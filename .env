# ═══════════════════════════════════════════════════════════════════════════════
# BRAIN SYSTEM — ROOT ENVIRONMENT
# Copy this to .env and fill in your values.
# Lines marked ← SUPERGROKIE are new variables added for supergrokie integration.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# ── Model selection ────────────────────────────────────────────────────────────
ANTHROPIC_MAIN_MODEL=claude-sonnet-4-20250514
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
OPENAI_MAIN_MODEL=gpt-5.4-mini
OPENAI_FAST_MODEL=gpt-5.4-nano
DEFAULT_CLAUDE_MODEL=claude-sonnet-4-20250514
FAST_CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── supergrokie (code modification engine) ────────────────────────────────────
# Path to supergrokie inside the self-update container.
# Installed during image build. Do not change unless you mount it externally.
SUPERGROKIE_PATH=/usr/local/bin/supergrokie                    # ← SUPERGROKIE

# Git ref used to install supergrokie from source.
# Use "main" to track latest. Use a commit SHA to pin for reproducibility.
# Example: SUPERGROKIE_GIT_REF=a3f91b2d
# When changed, rebuild: docker compose build --no-cache self-update
SUPERGROKIE_GIT_REF=main                                       # ← SUPERGROKIE

# ── Databases ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
EDGEDB_DSN=edgedb://edgedb/main
EDGEDB_HOST=edgedb
EDGEDB_PORT=5656
EDGEDB_DATABASE=main
EDGEDB_CLIENT_TLS_SECURITY=insecure

# ── Local model ────────────────────────────────────────────────────────────────
LOCAL_MODEL_NAME=microsoft/phi-4-mini-instruct
LOCAL_MODEL_PATH=/models/local_llm
ADAPTER_PATH=/models/adapters
EMOTION_MODEL_PATH=/models/emotion
HF_TOKEN=hf_your-token-here
HF_HOME=/models/hf_cache

# ── Ollama ─────────────────────────────────────────────────────────────────────
# Docker containers cannot reach services bound to 127.0.0.1 on the host.
# Ollama must listen on 0.0.0.0 for Docker containers to connect.
#
# Linux (systemd):
#   sudo mkdir -p /etc/systemd/system/ollama.service.d
#   echo -e '[Service]\nEnvironment="OLLAMA_HOST=0.0.0.0"' | sudo tee /etc/systemd/system/ollama.service.d/override.conf
#   sudo systemctl daemon-reload && sudo systemctl restart ollama
#
# Mac / Docker Desktop: host.docker.internal works out of the box.
#
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LOCAL_MODEL=phi4

# ── Ollama performance tuning ─────────────────────────────────────────────────
# OLLAMA_KEEP_ALIVE: set on the HOST Ollama process (not in Docker).
# Controls how long models stay loaded in VRAM after the last request.
# Default is "5m". Set to "-1" to never unload — best for dedicated machines.
#
#   Linux (systemd):
#     echo -e '[Service]\nEnvironment="OLLAMA_HOST=0.0.0.0"\nEnvironment="OLLAMA_KEEP_ALIVE=-1"' | \
#       sudo tee /etc/systemd/system/ollama.service.d/override.conf
#     sudo systemctl daemon-reload && sudo systemctl restart ollama
#
#   Mac:  launchctl setenv OLLAMA_KEEP_ALIVE -1
#   Then: ollama serve (or restart Ollama app)
#
# OLLAMA_NUM_PARALLEL: concurrent requests Ollama will process (default 1).
# Increase if you have enough VRAM. Each parallel slot uses more memory.
#
#   Linux: add Environment="OLLAMA_NUM_PARALLEL=4" to the systemd override
#
# After changing Ollama env vars, restart the Ollama process (not Docker).

# ── Self-update / Supergrokie ─────────────────────────────────────────────────
SUPERGROKIE_WEBHOOK_SECRET=change-this-to-a-random-secret-min-32-chars
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_REPO=your-username/brain-system

# false = all code changes queued for human review (recommended)
# true  = auto-apply immediately (only when you fully trust the system)
AUTO_APPLY_CODE_CHANGES=false

# true  = every code change requires POST /update/approve/{id} before applying
# false = high-confidence low-risk changes may auto-apply
CODE_REVIEW_REQUIRED=true

# Path where self-update reads/writes service files.                 ← SUPERGROKIE
# Must match the volume mount in docker-compose.yml: ./services:/services
SERVICES_DIR=/services                                               # ← SUPERGROKIE

# ── Vision ─────────────────────────────────────────────────────────────────────
VISION_ENABLED=false

# ── Web Search ─────────────────────────────────────────────────────────────────
# When enabled, the reasoning engine can search the web for evidence, verify
# facts, and look up current information. The model decides when to search —
# it uses memory first and only searches when needed.
# Supported providers: openai, anthropic, xai, gemini (others fall back to no search)
WEB_SEARCH_ENABLED=true
VISION_MODEL=openai/clip-vit-base-patch32
VISION_CAPTURE_INTERVAL=0
CAMERA_INDEX=0
VISION_STORE_FRAMES=false

# ── Service URLs (internal Docker network) ─────────────────────────────────────
AMYGDALA_URL=http://amygdala:8001
HIPPOCAMPUS_URL=http://hippocampus:8002
CEREBELLUM_URL=http://cerebellum:8003
NEOCORTEX_URL=http://neocortex:8004
WORKING_MEMORY_URL=http://working-memory:8005
PERCEPTION_URL=http://perception:8006
VERIFICATION_URL=http://verification:8007
CROSS_DOMAIN_URL=http://cross-domain:8008
COMPASS_URL=http://compass:8009
FRAMEWORK_ROUTER_URL=http://framework-router:8010
SELF_UPDATE_URL=http://self-update:8011
KNOBS_URL=http://knobs:8090
CAUSAL_GRAPH_URL=http://causal-graph:8012
SIMULATOR_URL=http://simulator:8013
METACOGNITION_URL=http://metacognition:8014
GOALS_URL=http://goals:8015
LEARNER_URL=http://learner:8016
VISION_URL=http://vision:8017
THALAMUS_URL=http://thalamus:8000
AUTONOMY_URL=http://autonomy:8018
HYPOTHALAMUS_URL=http://hypothalamus:8019
INSIGHT_ENGINE_URL=http://insight-engine:8020
EMBED_QUEUE_URL=http://embed-queue:8021
DASHBOARD_URL=http://dashboard:8080

# ── Resource limits ────────────────────────────────────────────────────────────
ES_JAVA_OPTS=-Xms2g -Xmx2g
REDIS_MAX_MEMORY=1gb
LEARNER_MAX_MEMORY=8g
VISION_MAX_MEMORY=4g

# ── GPU / Learner ─────────────────────────────────────────────────────────────
# Torch wheel index — change at build time for your hardware:
#   NVIDIA GPU (default): https://download.pytorch.org/whl/cu121
#   CPU only:             https://download.pytorch.org/whl/cpu
#   AMD ROCm 6.0:         https://download.pytorch.org/whl/rocm6.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
# Which GPUs the learner container sees ("all" or "0", "0,1", etc.)
NVIDIA_VISIBLE_DEVICES=all

# ── Ports (exposed to host) ────────────────────────────────────────────────────
GATEWAY_PORT=8000
KNOBS_PORT=8090

# ── Internal paths ─────────────────────────────────────────────────────────────
WORKSPACE_PATH=/workspace
MODELS_PATH=/models